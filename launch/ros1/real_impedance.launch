<launch>
    <!-- overridable arguments -->
    <arg name="robot_host" default="192.168.1.100"/>
    <arg name="robot_port" default="8439"/>

    <!-- keyboard teleop -->
    <include file="$(find hex_ros_teleop_keyboard)/launch/ros1/teleop_keyboard.launch"/>

    <!-- real chassis driver (Maver, robot_type default 30 = X4H1) -->
    <include file="$(find hex_ros_robot_chassis)/launch/ros1/maver.launch">
        <arg name="robot_host" value="$(arg robot_host)"/>
        <arg name="robot_port" value="$(arg robot_port)"/>
    </include>

    <!-- impedance control node -->
    <include file="$(find hex_ros_demo_chassis_impedance)/launch/ros1/chassis_impedance.launch"/>
</launch>
